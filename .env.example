POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname
API_PORT=8000
WEB_PORT=3000
REACT_APP_API_DOMAIN_LOCAL=http://localhost:8000/
REACT_APP_FILE_ACCESS_DOMAIN_LOCAL=http://localhost:8000/
NEXT_PUBLIC_API_DOMAIN_LOCAL=http://localhost:8000/
NEXT_PUBLIC_FILE_ACCESS_DOMAIN_LOCAL=http://localhost:8000/
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET_KEY=supersecretkey

# Environment: 'local' or 'production'
# In local mode, emails are logged instead of sent
# In production mode, MAIL_* variables are required
ENVIRONMENT=local

# --- Utterance segmentation (api/services/segmentation.py) ---
# All optional; defaults shown. Uploaded media is decoded to 16 kHz mono and
# split into utterance WAVs using Silero VAD before entering the labeling queue.
# SEGMENTER_BACKEND=silero              # silero | energy (energy = adaptive RMS fallback)
# SEGMENTER_VAD_THRESHOLD=0.5           # speech probability trigger (0-1)
# SEGMENTER_MIN_SPEECH_MS=250           # ignore speech bursts shorter than this
# SEGMENTER_MIN_SILENCE_MS=300          # silence needed to end a speech region
# SEGMENTER_SPEECH_PAD_MS=150           # padding kept around each speech region
# SEGMENTER_MIN_UTTERANCE_S=1.0         # drop utterances shorter than this
SEGMENTER_MAX_UTTERANCE_S=35.0        # split utterances longer than this
# SEGMENTER_MAX_MERGE_GAP_S=1.0         # merge speech regions across gaps up to this
# SEGMENTER_MIN_RMS_DBFS=-55            # drop near-silent segments
# SEGMENTER_MAX_CLIPPING_RATIO=0.02     # drop segments with more clipped samples
# SEGMENTER_MIN_AVG_SPEECH_PROB=0.30    # drop segments that are mostly non-speech

